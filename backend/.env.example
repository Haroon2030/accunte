# ═══ الإنتاج (Docker/الاستضافة): ضع هذه في متغيرات بيئة الخدمة، ولا تضعها في الكود ═══
# SECRET_KEY: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
ALLOWED_HOSTS=your-domain,localhost
# عند الوصول عبر HTTPS خلف وكيل (Dokploy/Traefik):
CSRF_TRUSTED_ORIGINS=https://account.alrsheed.net
COOKIES_SECURE=true
# عدد الوكلاء العكسيين أمام التطبيق (غالبًا 1 أو 2). يُظهر IP العميل الحقيقي في سجل التدقيق
PROXY_HOPS=1
SECURE_HSTS_SECONDS=0
# اختياري: ينشئ مدير النظام مرة واحدة إن لم يكن موجودًا (لا يغيّر كلمة مرور مدير موجود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# إعدادات ربط واتساب عبر Evolution API (انسخ هذا الملف إلى .env واملأ القيم)
WHATSAPP_ENABLED=false
WHATSAPP_ASYNC_DISPATCH=true
EVOLUTION_API_URL=http://your-evolution-host:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=hr
EVOLUTION_API_TIMEOUT=20
WHATSAPP_DEFAULT_COUNTRY=966
# الدعم الآلي الذكي (اختياري): بدون المفتاح يعمل المساعد بالقائمة المرقّمة فقط
GROQ_API_KEY=
# رقم واتساب الدعم لبوابة الموردين (دولي بلا +)
WHATSAPP_SUPPORT_NUMBER=
GROQ_MODEL=openai/gpt-oss-120b
# رمز سري لحماية رابط الاستقبال (Webhook): ولّده بـ python -c "import secrets;print(secrets.token_urlsafe(32))"
WHATSAPP_WEBHOOK_SECRET=
# العنوان العام الذي يصل منه خادم Evolution إلى هذا النظام (مثال: http://72.61.107.230:8096)
WHATSAPP_PUBLIC_BASE_URL=https://account.alrsheed.net

# ═══ Cloudflare R2: تخزين كل الملفات المرفوعة (مرفقات المطابقة والمقترحات والطلبات والصور) ═══
# USE_R2=true يجعل المفاتيح إلزامية، ويفشل الإقلاع إن نقص أي منها. فحص الاتصال: python manage.py r2_check
USE_R2=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
# مجلد داخل الـbucket لهذا النظام (يمنع اختلاط ملفاته بتطبيقات أخرى تشارك الـbucket)
R2_PREFIX=accounting
R2_PUBLIC_DOMAIN=
R2_SIGNED_URLS=true
R2_SIGNED_URL_EXPIRE=3600
R2_PROXY_MEDIA=true
